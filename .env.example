# Postgres connection string (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=
# Long random string used to sign session cookies: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated emails that can open /admin (you)
ADMIN_EMAILS=you@example.com
# Public URL of the deployed site, used in login emails
APP_URL=http://localhost:3000
# Resend (https://resend.com) for login emails. Without a key, links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Bengali Practice <login@yourdomain.com>

# Razorpay (https://dashboard.razorpay.com). International payments must be enabled for USD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Price in US dollars for 12 months of access
PRICE_USD=40
