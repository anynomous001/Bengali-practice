# Postgres connection string (Neon, Supabase, Vercel Postgres...)
DATABASE_URL=
# Random string (32+ chars) used to sign session cookies: openssl rand -base64 32
AUTH_SECRET=
# Comma-separated emails that can open /admin (you)
ADMIN_EMAILS=you@example.com
# Public URL of the deployed site, used in login emails
APP_URL=http://localhost:3000
# Resend (https://resend.com) for login emails. Without a key, links are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Bengali Practice <login@yourdomain.com>

# Razorpay (https://dashboard.razorpay.com). International payments must be enabled for USD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Price in US dollars for 12 months of access
PRICE_USD=50
# Optional. Students in India see the same price in rupees at today's exchange rate. Set PRICE_INR to fix a rupee price by hand,
# and USD_INR_RATE as the fallback rate used if the live rate cannot be fetched.
PRICE_INR=
USD_INR_RATE=90

# SEO and analytics (all optional)
# Google Analytics 4 measurement ID, like G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Content value of the verification meta tag from Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Your X / Twitter username, without the @ (adds twitter:site)
NEXT_PUBLIC_TWITTER_HANDLE=
